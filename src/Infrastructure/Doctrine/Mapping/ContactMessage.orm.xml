<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="AlexandreBulete\DddContactBundle\Domain\Model\ContactMessage" table="contact_message">
        <indexes>
            <!-- The inbox, most recent first; the count of unread ones. -->
            <index columns="received_at"/>
            <index columns="status,spam"/>
        </indexes>
        <id name="id" type="contact_message_id"/>
        <field name="senderName" type="string" column="sender_name" length="120"/>
        <field name="senderEmail" type="string" column="sender_email" length="180"/>
        <field name="subject" type="string" length="150" nullable="true"/>
        <field name="body" type="text"/>
        <field name="status" type="string" length="20" enum-type="AlexandreBulete\DddContactBundle\Domain\Model\MessageStatus"/>
        <field name="spam" type="boolean"/>
        <field name="receivedAt" type="datetime_immutable" column="received_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
    </entity>
</doctrine-mapping>
